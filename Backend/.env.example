# Copy to .env and fill in for your environment. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_ENGINE=postgres   # or "sqlite" for local dev without Postgres
DATABASE_NAME=rmrrs
DATABASE_USER=rmrrs
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# GMP access-control policy (defaults applied — confirm with client before go-live)
SESSION_IDLE_TIMEOUT_SECONDS=1800
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
